-- 6) تحديث total_amount (إجباري)
UPDATE orders o
SET total_amount = sub.total
FROM (
  SELECT order_id, SUM(quantity * unit_price_at_purchase) AS total
  FROM order_items
  GROUP BY order_id
) sub
WHERE o.id = sub.order_id;

